# copy to .env — loaded by the server/CLI/MCP server, and by docker compose
# Claude API (chat). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Voyage AI (cloud embeddings, optional — used by --embedder voyage / auto)
# https://dash.voyageai.com/
VOYAGE_API_KEY=

# --- docker compose options ---
# WITH_LOCAL_ML=1 bakes torch/sentence-transformers into the image (~2-3GB)
# so DOCSEARCH_EMBEDDER=e5 / e5-large / bge-m3 run fully offline
#WITH_LOCAL_ML=1
#DOCSEARCH_EMBEDDER=e5
#DOCSEARCH_PORT=8765
