# copy to .env — loaded by the server/CLI/MCP server, and by docker compose
# Claude API (chat). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Voyage AI (cloud embeddings, optional — used by --embedder voyage / auto)
# https://dash.voyageai.com/
VOYAGE_API_KEY=

# --- docker compose options ---
# WITH_LOCAL_ML=1 bakes torch/sentence-transformers into the image (~2-3GB)
# so DOCSEARCH_EMBEDDER=e5 / e5-large / bge-m3 run fully offline
#WITH_LOCAL_ML=1
#DOCSEARCH_EMBEDDER=e5
#DOCSEARCH_PORT=8765
# citation deep links — needed in Docker (mounted docs carry no .git);
# outside Docker it is auto-detected from the docs repo's git remote
#DOCSEARCH_GITHUB_BASE=https://github.com/SodaShikenn/doc-search/blob/main/sample_docs

# --- replaceable data source (machine with data access) ---
# host path of the real docs repo, mounted into the container at /docs
#DOCSEARCH_DOCS_HOST=/path/to/real/payroll-docs-repo
# or for the local (non-docker) run: see datasource.example.json
